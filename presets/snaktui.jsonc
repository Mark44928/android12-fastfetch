{
    // SnakTUI companion preset: same nine-row layout as presets/minimal.jsonc,
    // with the SnakTUI palette (#2DE2E6 keys, neon magenta logo).
    // Run it directly with:
    //   fastfetch -c presets/snaktui.jsonc --pipe
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/2.71.0/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/ascii.txt",
        "color": {
            "1": "38;2;255;43;214"
        }
    },
    "display": {
        "color": {
            "keys": "38;2;45;226;230"
        },
        "separator": "  ",
        "brightColor": false
    },
    "modules": [
        { "type": "title", "key": "╭─" },
        { "type": "os", "key": "│ OS" },
        { "type": "kernel", "key": "│ Kernel" },
        { "type": "uptime", "key": "│ Uptime" },
        { "type": "packages", "key": "│ Packages" },
        { "type": "shell", "key": "│ Shell" },
        { "type": "terminal", "key": "│ Terminal" },
        { "type": "memory", "key": "│ Memory" },
        { "type": "disk", "key": "│ Disk", "folders": "/data:/storage/emulated/0" },
        { "type": "datetime", "key": "╰─ Date" }
    ]
}
